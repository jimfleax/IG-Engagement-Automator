dist/
dist-temp/
.temp/
.tmp/
.cache/
.vite/
.turbo/

# Logs & debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables & local secrets
.env
.env.local
